FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      nut;
}
dimensions      [0 2 -1 0 0 0 0];
internalField   uniform 4.0e-5;
boundaryField
{
    farfield
    {
        type            freestream;
        freestreamValue $internalField;
    }
    "(wing_upper|wing_lower|tip_left|tip_right|te_wall|closure_wall)"
    {
        type            nutUSpaldingWallFunction;
        value           uniform 0;
    }
}
