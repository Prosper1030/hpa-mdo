FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}
dimensions      [0 1 -1 0 0 0 0];
internalField   uniform (6.5 0 0);
boundaryField
{
    farfield
    {
        type            freestreamVelocity;
        freestreamValue $internalField;
    }
    "(wing_upper|wing_lower|tip_left|tip_right|te_wall|closure_wall)"
    {
        type            noSlip;
    }
}
