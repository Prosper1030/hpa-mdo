    {
        type            forceCoeffs;
        libs            ("libforces.so");
        patches         (airfoil_upper airfoil_lower);
        rho             rhoInf;
        rhoInf          1.225;
        liftDir         (-0.00314158749 0 0.999995065);
        dragDir         (0.999995065 0 0.00314158749);
        CofR            (0.246276512 0.000000000 0.000000000);
        pitchAxis       (0 1 0);
        magUInf         6.5;
        lRef            1.003721543;
        Aref            33.420059598;
        writeControl    timeStep;
        writeInterval   1;
        log             true;
