/*--------------------------------*- C++ -*----------------------------------*\
| cfMesh cartesianMesh attempt for WO-006 verification-grade route             |
\*---------------------------------------------------------------------------*/
FoamFile
{
    version   2.0;
    format    ascii;
    class     dictionary;
    location  "system";
    object    meshDict;
}

surfaceFile "baseline_A_fullwing_farfield_and_split_walls.stl";

maxCellSize 0.75;
boundaryCellSize 0.08;
minCellSize 0.02;

localRefinement
{
    "wing_upper|wing_lower"
    {
        cellSize 0.04;
        refinementThickness 0.20;
    }
    "tip_left|tip_right|te_wall|closure_wall"
    {
        cellSize 0.06;
        refinementThickness 0.15;
    }
}

boundaryLayers
{
    patchBoundaryLayers
    {
        "wing_upper|wing_lower"
        {
            nLayers 12;
            thicknessRatio 1.18;
            maxFirstLayerThickness 0.0025;
            allowDiscontinuity 1;
        }
        "tip_left|tip_right|te_wall|closure_wall|farfield"
        {
            nLayers 0;
            allowDiscontinuity 1;
        }
    }
    optimiseLayer 1;
    optimisationParameters
    {
        nSmoothNormals 3;
        maxNumIterations 3;
        featureSizeFactor 0.3;
        reCalculateNormals 1;
        relThicknessTol 0.2;
    }
}

renameBoundary
{
    defaultType wall;
    newPatchNames
    {
        "farfield.*|farfield"
        {
            newName farfield;
            type patch;
        }
        "wing_upper.*|wing_upper"
        {
            newName wing_upper;
            type wall;
        }
        "wing_lower.*|wing_lower"
        {
            newName wing_lower;
            type wall;
        }
        "tip_left.*|tip_left"
        {
            newName tip_left;
            type wall;
        }
        "tip_right.*|tip_right"
        {
            newName tip_right;
            type wall;
        }
        "te_wall.*|te_wall"
        {
            newName te_wall;
            type wall;
        }
        "closure_wall.*|closure_wall"
        {
            newName closure_wall;
            type wall;
        }
    }
}
