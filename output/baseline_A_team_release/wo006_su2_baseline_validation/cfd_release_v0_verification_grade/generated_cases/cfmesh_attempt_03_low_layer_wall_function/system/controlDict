FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
application     simpleFoam;
startFrom       startTime;
startTime       0;
stopAt          endTime;
endTime         160;
deltaT          1;
writeControl    timeStep;
writeInterval   20;
purgeWrite      0;
functions
{
    forceCoeffs_primary
    {
        type            forceCoeffs;
        libs            ("libforces.so");
        patches         (wing_upper wing_lower);
        rho             rhoInf;
        rhoInf          1.225;
        liftDir         (0 0 1);
        dragDir         (1 0 0);
        CofR            (0.246276512 0.000000000 0.000000000);
        pitchAxis       (0 1 0);
        magUInf         6.5;
        lRef            1.003721543;
        Aref            33.420059598;
        writeControl    timeStep;
        writeInterval   1;
        log             true;
    }

