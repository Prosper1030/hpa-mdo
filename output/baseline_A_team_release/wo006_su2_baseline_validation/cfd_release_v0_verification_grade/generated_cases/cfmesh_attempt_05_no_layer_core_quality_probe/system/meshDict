/*--------------------------------*- C++ -*----------------------------------*\
| cfMesh cartesianMesh bounded attempt 05: no-layer core-quality probe.      |
\*---------------------------------------------------------------------------*/
FoamFile
{
    version   2.0;
    format    ascii;
    class     dictionary;
    location  "system";
    object    meshDict;
}

surfaceFile "baseline_A_fullwing_farfield_and_split_walls.stl";
maxCellSize 0.90;
minCellSize 0.04;
boundaryCellSize 0.50;

localRefinement
{
    wing_upper { cellSize 0.08; }
    wing_lower { cellSize 0.08; }
    tip_left { cellSize 0.10; }
    tip_right { cellSize 0.10; }
    te_wall { cellSize 0.10; }
    closure_wall { cellSize 0.12; }
}

// No boundaryLayers block: bounded core-quality probe to isolate whether
// cfMesh failures come from octree/core generation or layer extrusion.

renameBoundary
{
    defaultName default_wall;
    defaultType wall;
    newPatchNames
    {
        farfield { newName farfield; type patch; }
        wing_upper { newName wing_upper; type wall; }
        wing_lower { newName wing_lower; type wall; }
        tip_left { newName tip_left; type wall; }
        tip_right { newName tip_right; type wall; }
        te_wall { newName te_wall; type wall; }
        closure_wall { newName closure_wall; type wall; }
    }
}
